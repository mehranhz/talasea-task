{
  "name": "wallet-service",
  "version": "1.0.0",
  "private": true,
  "description": "High-scale wallet service. TypeScript compiled to CommonJS.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/concurrency-demo.ts",
    "check:ledger": "tsx scripts/ledger-check.ts",
    "test:e2e": "tsx --test --test-concurrency=1 test/e2e/**/*.test.ts"
  },
  "dependencies": {
    "bullmq": "^5.61.0",
    "express": "^5.1.0",
    "ioredis": "^5.8.1",
    "mongoose": "^8.19.1",
    "pino": "^9.11.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
